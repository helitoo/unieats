<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/neutral_0"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvPromoBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tag_orange_soft"
            android:gravity="center"
            android:text="🏷️"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/tvPromoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giảm giá 20%"
                android:textColor="@color/neutral_900"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPromoDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Áp dụng cho đơn từ 100k"
                android:textColor="@color/neutral_500"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPromoDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Hạn: 01/10/2023 - 31/10/2023"
                android:textColor="@color/orange_500"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPromoStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_orange_soft"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Hoạt động"
            android:textColor="@color/orange_500"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
