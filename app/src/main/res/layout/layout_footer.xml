<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llFooter"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/neutral_0"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <!-- Tab 1: Trang chủ (Default Active) -->
    <LinearLayout
        android:id="@+id/llTabHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_footer_active_tab"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/ivHomeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_home"
            app:tint="@color/orange_500" />

        <TextView
            android:id="@+id/tvHomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Trang chủ"
            android:textColor="@color/orange_500"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab 2: Tìm kiếm -->
    <LinearLayout
        android:id="@+id/llTabSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/ivSearchIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_search"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tvSearchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tìm kiếm"
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Tab 3: Xu hướng -->
    <LinearLayout
        android:id="@+id/llTabTrending"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/ivTrendingIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_trending"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tvTrendingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Xu hướng"
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Tab 4: Cá nhân -->
    <LinearLayout
        android:id="@+id/llTabProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/ivProfileIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_user"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tvProfileText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cá nhân"
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
