<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/neutral_0"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Chỉnh sửa quán ăn"
        android:textColor="@color/neutral_900"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Tên quán -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Tên quán"
        android:textColor="@color/dark_700"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:hint="Nhập tên quán"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textColor="@color/neutral_900"
        android:textSize="14sp" />

    <!-- Địa chỉ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="Địa chỉ chi tiết"
        android:textColor="@color/dark_700"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditAddress"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:hint="Địa chỉ quán"
        android:inputType="textPostalAddress"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textColor="@color/neutral_900"
        android:textSize="14sp" />

    <!-- Giá thấp nhất & cao nhất -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Giá min (đ)"
                android:textColor="@color/dark_700"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditPriceMin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:hint="20.000"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/neutral_900"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Giá max (đ)"
                android:textColor="@color/dark_700"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditPriceMax"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:hint="50.000"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/neutral_900"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Thẻ / Tag -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="Thẻ / Nhãn"
        android:textColor="@color/dark_700"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditTag"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:hint="Ví dụ: Giá sinh viên"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textColor="@color/neutral_900"
        android:textSize="14sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelEdit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_google"
            android:paddingHorizontal="16dp"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="@color/neutral_700"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveEdit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_orange"
            android:paddingHorizontal="20dp"
            android:text="Lưu thay đổi"
            android:textAllCaps="false"
            android:textColor="@color/neutral_0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
