<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".activities.restaurants.WriteReviewActivity">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/neutral_0"
        android:elevation="2dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="←"
            android:textColor="@color/neutral_900"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Viết đánh giá"
            android:textColor="@color/neutral_900"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderSearchIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:text="🔍"
            android:textSize="18sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Restaurant Name -->
            <TextView
                android:id="@+id/tvRestaurantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cơm nhà Góc Sân Trường"
                android:textColor="@color/neutral_900"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRatingPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bạn đánh giá trải nghiệm thế nào?"
                android:textColor="@color/neutral_500"
                android:textSize="14sp" />

            <!-- Interactive Stars Bar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStar1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="★"
                    android:textColor="@color/orange_500"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/tvStar2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="★"
                    android:textColor="@color/orange_500"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/tvStar3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="★"
                    android:textColor="@color/orange_500"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/tvStar4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="★"
                    android:textColor="@color/orange_500"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/tvStar5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="☆"
                    android:textColor="@color/neutral_300"
                    android:textSize="36sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Chi phí  ·  Chất lượng món  ·  Phục vụ  ·  Vệ sinh"
                android:textColor="@color/neutral_900"
                android:textSize="13sp" />

            <!-- Comment Card ("Đánh giá của bạn") -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/neutral_0"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đánh giá của bạn"
                        android:textColor="@color/neutral_900"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etReviewComment"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="top|start"
                        android:hint="Chia sẻ trải nghiệm của bạn..."
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/neutral_900"
                        android:textColorHint="@color/neutral_300"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Không chia sẻ thông tin cá nhân."
                        android:textColor="@color/neutral_500"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Photos section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Ảnh trải nghiệm thực tế"
                android:textColor="@color/neutral_900"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Photo Box 1 -->
                <TextView
                    android:id="@+id/tvAddPhoto1"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⊕"
                    android:textColor="@color/neutral_500"
                    android:textSize="28sp" />

                <!-- Photo Box 2 -->
                <TextView
                    android:id="@+id/tvAddPhoto2"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⊕"
                    android:textColor="@color/neutral_500"
                    android:textSize="28sp" />

                <!-- Photo Box 3 -->
                <TextView
                    android:id="@+id/tvAddPhoto3"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⊕"
                    android:textColor="@color/neutral_500"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- Checkbox share social -->
            <CheckBox
                android:id="@+id/cbShareSocial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chia sẻ lên mạng xã hội"
                android:textColor="@color/neutral_900"
                android:textSize="14sp" />

            <!-- Post Review Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPostReview"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_button_orange"
                android:text="Đăng đánh giá"
                android:textAllCaps="false"
                android:textColor="@color/neutral_0"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
